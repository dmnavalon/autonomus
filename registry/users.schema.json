{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutonomusUsersRegistry",
  "type": "object",
  "required": ["version", "users"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chat_id", "username", "role"],
        "properties": {
          "chat_id": { "type": ["integer", "null"] },
          "username": { "type": "string" },
          "role": { "type": "string", "enum": ["owner", "developer", "viewer"] },
          "last_active_slug": {
            "type": ["string", "null"],
            "pattern": "^[a-z][a-z0-9-]{0,29}$",
            "description": "Sticky context: last app slug this user worked on. Updated by webhook on /use or inline-keyboard pick."
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
