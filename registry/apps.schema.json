{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutonomusAppsRegistry",
  "type": "object",
  "required": ["version", "apps"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "repo", "default_branch", "stack", "owner_chat_id"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,29}$" },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Display name shown in the bot UI. Falls back to slug when absent."
          },
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "default_branch": { "type": "string" },
          "stack": { "type": "string", "enum": ["nextjs", "sveltekit", "astro", "other"] },
          "vercel_project_id": { "type": ["string", "null"] },
          "owner_chat_id": { "type": ["integer", "null"] },
          "collaborators": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Additional chat_ids allowed to send jobs against this app (besides owner)."
          },
          "created_at": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
