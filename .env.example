# =====================================================================
# Autonomus — Software Factory Agent — Environment variables (example)
# =====================================================================
# Copy this file to .env and fill in real values for local development.
# In production, set the same names as GitHub Secrets and Vercel envs.
# Never commit .env to git.

# ---------- Telegram ----------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random 32-byte hex string (openssl rand -hex 32)
# Used to verify Telegram webhook authenticity
TELEGRAM_WEBHOOK_SECRET=
# CSV of allowed Telegram chat IDs (e.g. "123456789,987654321")
TELEGRAM_ALLOWED_CHAT_IDS=

# ---------- LLM (Vercel AI Gateway) ----------
# Single key for all providers (OpenAI/Anthropic/Google/...) via the gateway
AI_GATEWAY_API_KEY=

# ---------- GitHub ----------
# PAT with scopes: repo, workflow (used by orchestrator on GH Actions)
GH_AUTOMATION_TOKEN=
# Where the factory lives (issues, workflows, prompts)
FACTORY_REPO=dmnavalon/autonomus
# GitHub owner/org under which generated apps are created
FACTORY_APPS_OWNER=dmnavalon

# ---------- Vercel ----------
# Personal access token from https://vercel.com/account/tokens
VERCEL_TOKEN=
# Team / scope id (find with: vercel teams ls)
VERCEL_TEAM_ID=

# ---------- Token-budget guardrails ----------
# Hard caps applied per job (orchestrator/src/budget.ts reads these)
MAX_JOB_INPUT_TOKENS=80000
MAX_JOB_OUTPUT_TOKENS=15000
MAX_JOB_COST_USD=2.00
MAX_REPAIR_CYCLES=5

# ---------- Optional fallbacks (not required when AI_GATEWAY_API_KEY is set) ----------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
